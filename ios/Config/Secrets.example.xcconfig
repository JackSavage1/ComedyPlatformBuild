// =============================================================================
// Secrets.example.xcconfig — TEMPLATE. Copy it to Secrets.xcconfig (same
// folder) and fill in your Supabase project's values:
//
//     cp ios/Config/Secrets.example.xcconfig ios/Config/Secrets.xcconfig
//
// Secrets.xcconfig is gitignored — never commit real keys.
//
// IMPORTANT: in .xcconfig files `//` starts a comment, so a plain
// https://… URL would be cut off after "https:". Write the URL with an
// empty variable between the slashes — `$()` expands to nothing:
//
//     https:/$()/abcdefghijklmnop.supabase.co
//
// Where to find the values: Supabase dashboard → Project Settings → API
// (Project URL, and the anon / publishable key — NOT the service_role key).
// =============================================================================

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-OR-PUBLISHABLE-KEY
